#!/usr/bin/env bash
set -euo pipefail
# Guard: reject commits containing project-specific references.
# Tools in this repo must be project-agnostic.

RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

# Patterns that indicate project-specific content.
# Keep patterns generic — never put client names, project names, or
# identifying info in this file. It is committed to a public repo.
#
# Maintainer: add client/project patterns to ~/.config/aitools/blocklist
# (one grep -E pattern per line). That file is local-only and never committed.
CHECKS=(
  '/home/[a-z]+|~/\.(claude|config)/|Hardcoded home directory path'
  '\bglab\b|\bgh\b issue|\bgh\b pr|Specific CLI tool reference'
  '\b(GitLab|GitHub|Bitbucket|Jira|Linear|Asana)\b|Specific platform reference'
  '\b(Django|Rails|Express|Next\.js|Flask|Spring|Laravel)\b|Specific framework reference'
  '\b(pytest|jest|mocha|vitest|rspec|phpunit)\b|Specific test runner reference'
  '\b(npm|yarn|pip|cargo|maven|gradle|bun|pnpm)\b run|Specific package manager command'
  '\b(Docker|Kubernetes|docker.compose)\b|Specific infrastructure tool reference'
)

# Load local blocklist (client names, project identifiers, emails, etc.)
LOCAL_BLOCKLIST="${HOME}/.config/aitools/blocklist"
if [[ -f "$LOCAL_BLOCKLIST" ]]; then
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    CHECKS+=("${line}")
  done < "$LOCAL_BLOCKLIST"
fi

violations=0
tmpfile=$(mktemp)
trap 'rm -f "$tmpfile"' EXIT

# --- Check: version bump required when plugin content changes ---
# Find plugins with staged content changes but no plugin.json version bump.
staged_all=$(git diff --cached --name-only --diff-filter=ACMRD) || true
changed_plugins=$(echo "$staged_all" | grep -oP '^plugins/[^/]+' | sort -u || true)

for plugin_dir in $changed_plugins; do
  manifest="$plugin_dir/.claude-plugin/plugin.json"

  # Skip if plugin.json itself is staged (version was likely bumped)
  if echo "$staged_all" | grep -qxF "$manifest"; then
    continue
  fi

  # Plugin content changed but plugin.json didn't
  echo -e "${RED}BLOCKED${NC} [$plugin_dir] ${YELLOW}Version not bumped${NC}"
  echo "  Plugin files changed but $manifest was not updated."
  echo "  Bump the version in plugin.json before committing."
  echo "$plugin_dir" >> "$tmpfile"
done

# Get staged plugin content (skip repo-level docs and hooks)
staged_files=$(git diff --cached --name-only --diff-filter=ACM -- \
  'plugins/' ':!hooks/' ':!.gitignore' ':!LICENSE') || true

if [[ -z "$staged_files" && ! -s "$tmpfile" ]]; then
  exit 0
fi

if [[ -z "$staged_files" ]]; then
  # Only version-bump violations, skip pattern checks
  staged_files=""
fi

for check in "${CHECKS[@]}"; do
  pattern="${check%|*}"
  label="${check##*|}"

  # Search staged content (not working tree) for the pattern
  while IFS= read -r file; do
    matches=$(git show ":$file" 2>/dev/null | grep -inE "$pattern" || true)
    if [[ -n "$matches" ]]; then
      while IFS= read -r match; do
        echo -e "${RED}BLOCKED${NC} [$file] ${YELLOW}${label}${NC}"
        echo "  $match"
      done <<< "$matches"
      echo "$file" >> "$tmpfile"
    fi
  done <<< "$staged_files"
done

violations=$(sort -u "$tmpfile" 2>/dev/null | wc -l)

if [[ "$violations" -gt 0 ]]; then
  echo ""
  echo -e "${RED}Commit rejected:${NC} $violations file(s) contain project-specific references."
  echo "Tools in this repo must be project-agnostic."
  echo ""
  echo "If this is a false positive, commit with --no-verify."
  exit 1
fi

exit 0
